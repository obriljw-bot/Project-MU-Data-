' ? 누적데이터에서 브랜드 목록 로드
Private Sub LoadBrandListFromAccumulated()
    On Error Resume Next
    
    Dim ws As Worksheet
    Dim wsAccum As Worksheet
    Dim brandDict As Object
    Dim lastRow As Long
    Dim i As Long
    Dim brandName As String
    Dim useFlag As String
    
    Set brandDict = CreateObject("Scripting.Dictionary")
    lstBrands.Clear
    
    ' 1. 브랜드설정에서 로드
    Set ws = ThisWorkbook.Sheets("브랜드설정")
    
    If Not ws Is Nothing Then
        lastRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row
        
        For i = 2 To lastRow
            brandName = Trim(ws.Cells(i, 1).value)
            useFlag = Trim(UCase(ws.Cells(i, 7).value))
            
            If brandName <> "" And useFlag = "O" Then
                If Not brandDict.exists(brandName) Then
                    brandDict.Add brandName, Nothing
                    lstBrands.AddItem brandName
                End If
            End If
        Next i
    End If
    
    ' 2. 누적데이터에서 로드
    Set wsAccum = ThisWorkbook.Sheets("누적데이터")
    
    If Not wsAccum Is Nothing Then
        lastRow = wsAccum.Cells(wsAccum.Rows.Count, 3).End(xlUp).Row
        
        If lastRow > 1 Then
            For i = 2 To lastRow
                brandName = Trim(wsAccum.Cells(i, 3).value)
                
                If brandName <> "" And Not brandDict.exists(brandName) Then
                    brandDict.Add brandName, Nothing
                    lstBrands.AddItem brandName
                End If
            Next i
        End If
    End If
    
    If lstBrands.ListCount > 0 Then
        Call SortListBox(lstBrands)
        If Not lblBrandSelect Is Nothing Then
            lblBrandSelect.Caption = "선택 - 총 " & lstBrands.ListCount & "개"
        End If
    Else
        If Not lblBrandSelect Is Nothing Then
            lblBrandSelect.Caption = "?? 브랜드 없음"
        End If
    End If
    
    On Error GoTo 0
End Sub

' 브랜드 목록 새로고침
Private Sub btnRefreshBrands_Click()
    On Error Resume Next
    If optModeExport.value Then
        LoadBrandListFromAccumulated
    Else
        MsgBox "데이터 출력 모드에서만 사용 가능합니다.", vbInformation
    End If
    On Error GoTo 0
End Sub

' 리스트박스 정렬
Private Sub SortListBox(lb As MSForms.ListBox)
    On Error Resume Next
    Dim items() As String
    Dim i As Long, j As Long
    Dim temp As String
    
    If lb.ListCount <= 1 Then Exit Sub
    
    ReDim items(0 To lb.ListCount - 1)
    
    For i = 0 To lb.ListCount - 1
        items(i) = lb.List(i)
    Next i
    
    For i = 0 To UBound(items) - 1
        For j = i + 1 To UBound(items)
            If items(i) > items(j) Then
                temp = items(i)
                items(i) = items(j)
                items(j) = temp
            End If
        Next j
    Next i
    
    lb.Clear
    For i = 0 To UBound(items)
        lb.AddItem items(i)
    Next i
    
    On Error GoTo 0
End Sub

