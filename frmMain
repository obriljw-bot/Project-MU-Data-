Private Sub UserForm_Initialize()
    ' 리스트박스 설정
    With lstFiles
        .ColumnCount = 3
        .ColumnWidths = "200;100;0"
        .Clear
    End With
    
    ' 매장 목록 로드
    LoadStoreList
    
    ' 체크박스 기본값
    chkSummary.value = (GetSetting(SET_요약시트) = "O")
    chkValidate.value = (GetSetting(SET_중복검증) = "O")
    
    ' 모드 초기화
    InitializeMode
    
    ' 일자 필터 초기화
    InitializeDateFilter
    
    ' 브랜드 필터 초기화
    InitializeBrandFilter
End Sub

